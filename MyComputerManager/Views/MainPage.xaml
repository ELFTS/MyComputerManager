<Page
    x:Class="MyComputerManager.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MyComputerManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="MainPage"  Background="{DynamicResource ControlFillColorDefaultBrush}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="0,6,0,0">
        <ListBox ItemTemplate="{StaticResource ListItemDataTemplate}"
                 ItemsSource="{Binding Items}"
                 Style="{StaticResource ListBoxStyle}" />

        <StackPanel HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Search24"
                           FontSize="48"
                           Foreground="{DynamicResource TextPlaceholderColorBrush}"
                           HorizontalAlignment="Center" />
            <TextBlock Text="未检测到相关项目&#10;你可以点击左上角的 “+” 添加自定义项"
                       TextAlignment="Center"
                       LineHeight="24"
                       FontSize="14"
                       Margin="0,16,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
