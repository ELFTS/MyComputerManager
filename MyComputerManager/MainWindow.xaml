<ui:FluentWindow x:Class="MyComputerManager.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Title="MainWindow"
             Width="400" Height="600"
             Icon="/Resources/openbox.ico"
             ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
             WindowCornerPreference="Round"
             WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Height="Auto"
                   Margin="0,38,0,4"
                   Grid.Row="1"
                   Background="{DynamicResource ApplicationBackgroundColorBrush}"
                   LastChildFill="False">
            <ui:Button Width="42" Height="42"
                         Margin="4,0,0,0"
                         ToolTip="返回主界面"
                         Style="{StaticResource MyMenuButtonStyle}"
                         Click="MenuBack_Click"
                         DockPanel.Dock="Left">
                <ui:SymbolIcon Symbol="ArrowHookUpLeft24" />
            </ui:Button>
            <ui:Button Width="42" Height="42"
                         Margin="4,0,0,0"
                         ToolTip="添加条目"
                         Style="{StaticResource MyMenuButtonStyle}"
                         Click="MenuAdd_Click"
                         DockPanel.Dock="Left">
                <ui:SymbolIcon Symbol="Add24" />
            </ui:Button>
            <ui:Button Width="42" Height="42"
                         Margin="4,0,0,0"
                         ToolTip="此电脑文件夹"
                         Style="{StaticResource MyMenuButtonStyle}"
                         Click="MenuFolderShow_Click"
                         DockPanel.Dock="Left">
                <ui:SymbolIcon Symbol="FolderAdd24" />
            </ui:Button>
            <ui:Button Width="42" Height="42"
                         Margin="4,0,0,0"
                         ToolTip="关于"
                         Style="{StaticResource MyMenuButtonStyle}"
                         Click="MenuInfo_Click"
                         DockPanel.Dock="Left">
                <ui:SymbolIcon Symbol="Info24" />
            </ui:Button>
            <ui:Button x:Name="ThemeMenuButton" Width="42" Height="42"
                         Margin="0,0,4,0"
                         ToolTip="主题"
                         Style="{StaticResource MyMenuButtonStyle}"
                         Click="MenuTheme_Click"
                         DockPanel.Dock="Right">
                <ui:Button.ContextMenu>
                    <ContextMenu x:Name="ThemeContextMenu"
                                 Placement="Bottom"
                                 PlacementTarget="{Binding ElementName=ThemeMenuButton}">
                        <ui:MenuItem x:Name="MenuItem_System" Header="跟随系统" IsCheckable="True" Click="ThemeModeMenuItem_Click" />
                        <ui:MenuItem x:Name="MenuItem_Light" Header="浅色" IsCheckable="True" Click="ThemeModeMenuItem_Click" />
                        <ui:MenuItem x:Name="MenuItem_Dark" Header="深色" IsCheckable="True" Click="ThemeModeMenuItem_Click" />
                    </ContextMenu>
                </ui:Button.ContextMenu>
                <ui:SymbolIcon Symbol="DarkTheme24" />
            </ui:Button>
        </DockPanel>
        <Border x:Name="RootMainGrid"
              Margin="0" CornerRadius="4,4,0,0"
              Grid.Row="2">
            <Frame x:Name="RootFrame"/>
        </Border>
        <Grid x:Name="WelcomeGrid"
              Grid.Row="1" Grid.RowSpan="2">
            <StackPanel VerticalAlignment="Center"
                        Margin="0,-20,0,0"
                        Grid.Column="1">
                <ui:ProgressRing IsIndeterminate="True" />
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="数据加载中..."
                           FontWeight="Medium" TextAlignment="Center"
                           FontSize="18" />
            </StackPanel>
        </Grid>

        <ui:TitleBar Title="MyComputerManager - v1.4.0"
                     Padding="10,10,10,12"
                     Grid.Row="0"
                     FontSize="14">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/openbox.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:SnackbarPresenter x:Name="RootSnackbar"
                              MaxWidth="600"
                              Grid.Row="1" Grid.RowSpan="2" />

        <ui:ContentDialogHost x:Name="RootDialog"
                              Grid.Row="1" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>